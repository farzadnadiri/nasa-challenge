{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spherex-sky-motion",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // React build, served directly; /api/* goes through the Worker first.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // FastAPI + astropy backend.
  "containers": [
    {
      "class_name": "SpherexApi",
      "image": "../backend/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "SpherexApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpherexApi"] }],

  // Finished results (frames, photometry, Gaia) keyed by normalised query string.
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "spherex-cache" }]
}
