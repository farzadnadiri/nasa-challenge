{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "spherex-sky-motion",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": { "enabled": true },

  // Public site. Wrangler creates the DNS record and certificate for the custom domain;
  // the workers.dev URL stays on as a fallback.
  "routes": [{ "pattern": "spherex.peykan.ai", "custom_domain": true }],
  "workers_dev": true,

  // Public base URL; the container reaches IRSA through <PUBLIC_URL>/api/_irsa/ (see src/index.ts).
  // IRSA_PROXY_KEY is a secret: `npx wrangler secret put IRSA_PROXY_KEY`.
  // Bump CONTAINER_GEN when the backend changes: requests then go to a fresh container running
  // the new image instead of the old instance, which only retires after 30 idle minutes.
  "vars": { "PUBLIC_URL": "https://spherex.peykan.ai", "CONTAINER_GEN": "12" },
  "secrets": { "required": ["IRSA_PROXY_KEY"] },

  // React build, served directly; /api/* goes through the Worker first.
  "assets": {
    "directory": "../frontend/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // FastAPI + astropy backend.
  "containers": [
    {
      "class_name": "SpherexApi",
      "image": "../backend/Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 2
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "API", "class_name": "SpherexApi" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["SpherexApi"] }],

  // Finished results (frames, photometry, Gaia) keyed by normalised query string.
  "r2_buckets": [{ "binding": "CACHE", "bucket_name": "spherex-cache" }],

  // Per-visitor limits for uploads (Cloudflare's limiter counts per 60 s).
  "ratelimits": [
    { "name": "UPLOAD_CREATE_LIMIT", "namespace_id": "2001", "simple": { "limit": 3, "period": 60 } },
    { "name": "UPLOAD_FILE_LIMIT", "namespace_id": "2002", "simple": { "limit": 60, "period": 60 } }
  ]
}
